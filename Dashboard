void commandHandler()
{

  if (!server.hasArg("cmd"))
  {
    server.send(
      400,
      "text/plain",
      "Missing command"
    );

    return;
  }

  String command =
    server.arg("cmd");

  if(command.length() > 0)
  {
    sendCommand(
      command.charAt(0)
    );
  }

  server.send(
    200,
    "text/plain",
    "Command sent"
  );
}


void statusHandler()
{

  String json = "{";

  json += "\"mode\":\"";
  json += mode;
  json += "\",";

  json += "\"distance\":\"";
  json += distance;
  json += "\",";

  json += "\"gas\":\"";
  json += gas;
  json += "\",";

  json += "\"front\":\"";
  json += frontIR;
  json += "\",";

  json += "\"rear\":\"";
  json += rearIR;
  json += "\",";

  json += "\"system\":\"";
  json += systemStatus;
  json += "\"";

  json += "}";

  server.send(
    200,
    "application/json",
    json
  );
}


void setup()
{

  Serial.begin(115200);

  WiFi.softAP(
    ssid,
    password
  );

  server.on(
    "/",
    dashboard
  );

  server.on(
    "/command",
    commandHandler
  );

  server.on(
    "/status",
    statusHandler
  );

  server.begin();

}


void loop()
{

  server.handleClient();

}
